# 未設定の接続情報はリポジトリ内の apps/api/.env を読み取り専用で参照します。
# 別の接続先を使う場合だけ設定してください。秘密情報をGitに追加しないでください。
# TRIVIA_PHOTO_DATABASE_URL=postgresql://...
# R2_ENDPOINT_URL=https://...r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=...
# TRIVIA_IMAGE_R2_BASE_URL=https://images.example.com

# 検索要件と写真の選定は、このフォルダで動くCodexが担当します。
# OpenAI APIキー・モデル・API予算の設定は不要です。
TRIVIA_PHOTO_BATCH_SIZE=5
# 既存アプリの画像設定と同じキーを使用。未設定なら既存の値または下記の既定値。
# TRIVIA_IMAGE_MAX_DIMENSION=1600
# TRIVIA_IMAGE_WEBP_QUALITY=78
R2_REVIEW_PREFIX=trivia-photo-review
# 厳密に非公開で確認したい場合は、公開アクセスを無効にした別バケットを指定。
# 同じバケットの別フォルダだけでは非公開にはなりません。
# R2_REVIEW_BUCKET_NAME=private-review-bucket
# TRIVIA_PHOTO_USER_AGENT=TriviaPhoto/0.1 (contact: your-contact-url)
