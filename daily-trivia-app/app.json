{
  "expo": {
    "name": "毎日雑学",
    "slug": "daily-trivia-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "dailytrivia",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dailytrivia.app",
      "buildNumber": "103",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dailytrivia.app",
          "group.com.dailytrivia.app"
        ]
      },
      "infoPlist": {
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": [
          "arm64"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "86V3PV77T6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dailytrivia.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "./plugins/withPodfileFix",
      "expo-background-fetch",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "@bacons/apple-targets",
        {
          "teamId": "86V3PV77T6"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-4541342273103383~2822165802"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.dailytrivia.app.TriviaWidgetExtension",
                  "targetName": "TriviaWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.dailytrivia.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.dailytrivia.app.TriviaWidgetExtension",
                  "targetName": "TriviaWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.dailytrivia.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dc1668f6-d213-4b7f-92d0-8bf25a7d4902"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc1668f6-d213-4b7f-92d0-8bf25a7d4902"
    }
  }
}