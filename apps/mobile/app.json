{
  "expo": {
    "name": "毎日雑学",
    "slug": "daily-trivia-app",
    "owner": "nobooooooo",
    "version": "1.0.38",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "dailytrivia",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dailytrivia.app",
      "buildNumber": "144",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dailytrivia.app"
        ]
      },
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "ウィジェットのスクリーンショットをカメラロールに保存するために使用します。",
        "NSLocationWhenInUseUsageDescription": "現在地の近くにあるご当地雑学を表示・解放するために位置情報を使用します。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "アプリを開いていないときも近くのご当地雑学を見つけてお知らせするために位置情報を使用します。移動履歴は保存しません。",
        "NSUserNotificationUsageDescription": "近くのご当地雑学が解放されたことをお知らせするために通知を使用します。",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": [
          "arm64"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "86V3PV77T6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dailytrivia.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "./plugins/withPodfileFix",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地の近くにあるご当地雑学を表示・解放するために位置情報を使用します。",
          "locationAlwaysAndWhenInUsePermission": "アプリを開いていないときも近くのご当地雑学を見つけてお知らせするために位置情報を使用します。移動履歴は保存しません。",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-background-fetch",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DotGothic16-Regular.ttf"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "@bacons/apple-targets",
        {
          "teamId": "86V3PV77T6"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-4541342273103383~2822165802"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.dailytrivia.app.TriviaWidgetExtension",
                  "targetName": "TriviaWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.dailytrivia.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "36d60f1c-778f-453a-8260-fa712a7fe652"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
